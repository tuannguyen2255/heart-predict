# ---- Frontend (Next.js) ----
NEXT_PUBLIC_API_LOCAL_URL=http://127.0.0.1:8000
# Optional CDN origin, configured at build time (serves /_next/static/).
ASSET_PREFIX=
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
JWT_SECRET=

# ---- Backend (FastAPI) ----
DB_HOST=localhost
DB_PORT=3306
DB_POOL_SIZE=10
DB_USER=
DB_PASSWORD=
DB_NAME=
JWT_SECRET_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_CONNECT_TIMEOUT_SECONDS=10
GROQ_READ_TIMEOUT_SECONDS=45
GROQ_REQUEST_TIMEOUT_SECONDS=60
GROQ_MAX_COMPLETION_TOKENS=768
MODEL_DIR=./models
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
